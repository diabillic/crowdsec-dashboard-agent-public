# Generated by dockerfile-agent from: deploy/lxc/crowdsec-agent-install, deploy/lxc/bootstrap-agent.sh, requirements.txt, crowdsec_agent/config.py, crowdsec_agent/health.py.
# Don't edit by hand: it's regenerated whenever those files change. Change them instead.
#
# Build: docker build --pull --build-arg PATCHED_AT=$(date +%s) --build-arg REVISION=$(git rev-parse HEAD) -t crowdsec-agent .
# Run:   docker run -d --name crowdsec-agent --restart unless-stopped \
#     --env-file agent.env \
#     -v crowdsec-agent-data:/var/lib/crowdsec-agent \
#     -p 8080:8080 \
#     -p 8765:8765 \
#     crowdsec-agent
#
# agent.env holds the settings in .env.example (the deploy workflow renders it from repo variables and secrets).

FROM python:3.13-slim-trixie

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
ENV TZ=America/New_York

ARG DEBIAN_FRONTEND=noninteractive
ARG PATCHED_AT=unknown
RUN echo "Patching the base OS ($PATCHED_AT)" \
 && apt-get update \
 && apt-get -y full-upgrade \
 && apt-get install -y --no-install-recommends ca-certificates tzdata \
 && ln -snf "/usr/share/zoneinfo/$TZ" /etc/localtime && echo "$TZ" > /etc/timezone \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN groupadd --system crowdsec-agent \
 && useradd --system --gid crowdsec-agent --home-dir /var/lib/crowdsec-agent --shell /usr/sbin/nologin crowdsec-agent \
 && install -d -o crowdsec-agent -g crowdsec-agent /var/lib/crowdsec-agent

WORKDIR /opt/crowdsec-agent/app
COPY requirements.txt ./
RUN pip install -r requirements.txt
COPY crowdsec_agent/ ./crowdsec_agent/
ARG REVISION=unknown
RUN echo "$REVISION" > REVISION

ENV STATE_PATH=/var/lib/crowdsec-agent/state.json
USER crowdsec-agent
VOLUME ["/var/lib/crowdsec-agent"]
EXPOSE 8080 8765
HEALTHCHECK --interval=60s --timeout=15s --start-period=2m --retries=5 \
  CMD ["python", "-m", "crowdsec_agent.health"]
CMD ["python", "-m", "crowdsec_agent"]
