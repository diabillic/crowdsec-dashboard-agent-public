# Reference for every setting. In production these come from GitHub repo variables/secrets
# and are rendered to /etc/agents/crowdsec-agent.env on deploy; use this file for local runs.

# --- Required ---
# CrowdSec's Local API, as reachable from the agent (the container's port 8080 must be published).
CROWDSEC_LAPI_URL=http://192.168.1.10:8080
# The machine the agent logs in as, registered on the CrowdSec side with:
#   docker exec crowdsec cscli machines add crowdsec-dashboard --password '<long random>' -f /dev/null
# (keep -f /dev/null so CrowdSec's own credentials file isn't overwritten)
CROWDSEC_MACHINE_ID=crowdsec-dashboard
CROWDSEC_PASSWORD=

# --- Optional ---
# CrowdSec's Prometheus endpoint (config.yaml: prometheus.enabled true, level full). Without it the
# dashboard has no blocklist counts, AppSec counters, log-source parsing or API client stats.
CROWDSEC_METRICS_URL=http://192.168.1.10:6060/metrics

POLL_SECONDS=60
# How far back the first sync reads, and how long alerts are kept (CrowdSec flushes its own sooner)
HISTORY_DAYS=30
RETENTION_DAYS=90

# The dashboard (read-only). Set a password to require basic auth (any user name).
DASHBOARD_PORT=8080
DASHBOARD_PASSWORD=

# Apprise URLs, comma separated, for "CrowdSec is unreachable" and its recovery:
#   discord://webhook_id/webhook_token   ntfy://ntfy.sh/topic
NOTIFY_URLS=
RENOTIFY_HOURS=12
# CrowdSec must fail this long before it's reported (restarts and updates stay quiet)
DOWN_MINUTES=10

# --- Agent bus (optional): read-only MCP tools for a chat assistant ---
AGENT_BUS_TOKEN=
AGENT_BUS_PORT=8765
BOT_ALERT_URL=
